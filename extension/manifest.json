{
  "manifest_version": 3,
  "name": "Ascend — side panel",
  "version": "1.0.0",
  "description": "Keeps today's Ascend quests and sticky notes docked beside your Chrome tabs, in sync with the app.",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "storage"],
  "action": { "default_title": "Ascend quests", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.github.io/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
